# Docker build ignore — keeps image lean and prevents secrets leaking into image

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# Virtual environment
venv/
.venv/
env/

# Local secrets — NEVER bake into image; use Railway env vars
.env
storage_state.json

# Dev artifacts
screenshots/
logs/
*.log

# Editor
.vscode/
.idea/
*.swp

# Git
.git/
.gitignore

# Test files
tests/
